# Kit dumps (matches any path named these):
#   {script}/.distssh/go/       go batches
#   {script}/.distssh/drive     omitted drive result root
#   {project}/.distssh/setup    setup logs
#   legacy `.distsshkit/` is still ignored when present
# Demo drivers still set output/ via init_output_dir!.
# results/ is the old omitted drive/go default (leftover trees).
.distssh/
.distsshkit/
output/
results/
data/
runner_*.log
drive_*.log
go_*.log

