# Pinned elan bootstrap (do not use elan/master or elan-init.sh /releases/latest).
# v3.1.1 elan-init.sh always resolves GitHub /releases/latest for the installer
# tarball; we download the v3.1.1 release asset directly instead.
ELAN_RELEASE=v3.1.1
ELAN_ARCH=x86_64-unknown-linux-gnu
ELAN_BINARY_URL=https://github.com/leanprover/elan/releases/download/v3.1.1/elan-x86_64-unknown-linux-gnu.tar.gz
ELAN_BINARY_SHA256=4f084c99b3cd2cda057f690792541f679aa3f43f695941dc3a6874895f78e87e